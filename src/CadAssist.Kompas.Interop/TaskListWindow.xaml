<Window x:Class="CadAssist.Kompas.Interop.TaskListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Assist — задачи проекта"
        Height="560"
        Width="1040"
        MinHeight="440"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="CAD Assist — задачи проектирования" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ModelPathText" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ContextPathText" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="Gray" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="Обновить" Width="110" Height="30" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="AddTaskButton" Content="Добавить тестовую задачу" Width="190" Height="30" Margin="0,0,8,0" Click="AddTaskButton_Click" />
            <Button x:Name="CompleteTaskButton" Content="Завершить задачу" Width="150" Height="30" Margin="0,0,8,0" Click="CompleteTaskButton_Click" />
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>

        <DataGrid Grid.Row="2"
                  x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Завершена">
                            <Setter Property="Foreground" Value="Gray" />
                            <Setter Property="Opacity" Value="0.72" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding Assignee}" Width="130" />
                <DataGridTextColumn Header="Файл модели" Binding="{Binding ModelPath}" Width="160" />
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                <DataGridTextColumn Header="Завершена" Binding="{Binding CompletedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                <DataGridTextColumn Header="Комментарий" Binding="{Binding CompletionComment}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray" />
    </Grid>
</Window>
