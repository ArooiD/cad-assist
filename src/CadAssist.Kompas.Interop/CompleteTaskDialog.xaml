<Window x:Class="CadAssist.Kompas.Interop.CompleteTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завершение задачи"
        Height="260"
        Width="520"
        MinHeight="240"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Завершение задачи" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="TaskTitleText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray" />
        </StackPanel>

        <TextBox Grid.Row="1"
                 x:Name="CommentTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" x:Name="ValidationText" Margin="0,8,0,0" Foreground="DarkRed" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Завершить" Width="110" Height="30" Margin="0,0,8,0" Click="CompleteButton_Click" />
            <Button Content="Отмена" Width="90" Height="30" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
